FROM python:3.12-slim
ARG APP_VERSION=0.1.0-dev
LABEL org.opencontainers.image.title="Case File Manager OCR" \
      org.opencontainers.image.version="${APP_VERSION}"
RUN apt-get update \
 && apt-get install -y --no-install-recommends ocrmypdf tesseract-ocr tesseract-ocr-eng \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --no-create-home app
ENV TOOL_NAME=ocr TOOL_CHECK="tesseract --version" PYTHONUNBUFFERED=1
COPY health.py /srv/health.py
USER 10001
EXPOSE 8080
CMD ["python", "/srv/health.py"]
